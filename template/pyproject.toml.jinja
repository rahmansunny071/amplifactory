[project]
name = "[[ project_name ]]"
version = "0.0.0"
description = "[[ description ]]"
readme = "README.md"
authors = [{ name = "[[ author_name ]]", email = "[[ author_email ]]" }]
requires-python = ">=[[ python_min ]]"
dependencies = []

[project.optional-dependencies]
dev = ["pytest>=8"]
[% if cli_name %]
[project.scripts]
[[ cli_name ]] = "[[ package_name ]].cli:main"
[% endif %]
[project.urls]
Homepage = "[[ homepage ]]"
Repository = "https://github.com/[[ maintainer_github ]]/[[ project_name ]]"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["[[ package_name ]]"]

[tool.ruff]
line-length = 100
