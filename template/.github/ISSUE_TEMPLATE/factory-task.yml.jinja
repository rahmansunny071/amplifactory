name: Factory task
description: Work for the agent factory (you add factory:design to start it)
body:
  - type: textarea
    id: goal
    attributes:
      label: Goal
      description: What should be true when this is done? User-visible behavior.
    validations: { required: true }
  - type: textarea
    id: context
    attributes:
      label: Context & pointers
      description: Relevant modules, specs, docs, prior issues.
  - type: textarea
    id: acceptance
    attributes:
      label: Acceptance criteria
      description: Checkable bullets. Offline-testable where possible.
    validations: { required: true }
  - type: textarea
    id: out_of_scope
    attributes:
      label: Out of scope
  - type: dropdown
    id: areas
    attributes:
      label: Areas affected
      multiple: true
      options: [[ issue_areas | tojson ]]
