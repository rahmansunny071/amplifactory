name: factory-review
# Actions mode with Copilot. Reviews a factory/issue-N PR against its design. GitHub holds the
# pull_request run of a PR the build agent opens until it's approved; factory-build approves it.
# workflow_dispatch (input pr) lets you, and only you, review a PR again on demand.
on:
  pull_request:
    types: [opened, synchronize]
  workflow_dispatch:
    inputs:
      pr:
        description: Number of the factory/issue-N pull request to review
        required: true

jobs:
  review:
    if: >
      (github.event_name == 'workflow_dispatch' &&
       github.triggering_actor == '[[ maintainer_github ]]') ||
      (github.event.pull_request.head.repo.full_name == github.repository &&
       startsWith(github.event.pull_request.head.ref, 'factory/issue-'))
    # The runner pool on your Mac when FACTORY_RUNNER is local and the repo is private (not internal:
    # every member of an enterprise can write its issues); otherwise GitHub's.
    # Anyone can comment in a public repo, and an agent on your Mac could read your files.
    runs-on: ${{ vars.FACTORY_RUNNER == 'local' && github.event.repository.visibility == 'private' && (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && fromJSON(format('["self-hosted","factory-run-{0}"]', github.run_id)) || 'ubuntu-latest' }}
    timeout-minutes: 20
    concurrency:
      group: factory-review-${{ inputs.pr || github.event.pull_request.number }}
      cancel-in-progress: true
    # copilot-requests: the workflow's own token signs in the Copilot CLI; usage bills the repo
    # owner's Copilot seat. contents: read, so this agent can't push or merge. checks, statuses and
    # actions: read let it see CI (gh pr checks).
    permissions: { contents: read, pull-requests: write, checks: read, statuses: read, actions: read, copilot-requests: write }
    env:
      FACTORY_COPILOT_VERSION: "1.0.116"
      COPILOT_AUTO_UPDATE: "false"
    steps:
      # A dispatch names any PR number: review only a same-repo factory/issue-N PR.
      - id: pr
        name: The PR is a factory/issue-N PR from this repo
        env:
          GH_TOKEN: ${{ github.token }}
          PR: ${{ inputs.pr || github.event.pull_request.number }}
        run: |
          case "$PR" in
            ''|*[!0-9]*) echo "::error::not a PR number: '$PR'"; exit 1 ;;
          esac
          head=$(gh pr view "$PR" -R "$GITHUB_REPOSITORY" --json headRefName --jq .headRefName)
          fork=$(gh pr view "$PR" -R "$GITHUB_REPOSITORY" --json isCrossRepository --jq .isCrossRepository)
          n=${head#factory/issue-}
          case "$head:$n" in
            factory/issue-*:*[!0-9]*|factory/issue-*:) bad=1 ;;
            factory/issue-*) bad= ;;
            *) bad=1 ;;
          esac
          if [ -n "$bad" ]; then
            echo "::error::PR #$PR is not a factory/issue-N PR (its branch is '$head')"; exit 1
          fi
          if [ "$fork" != false ]; then
            echo "::error::PR #$PR comes from a fork"; exit 1
          fi
          echo "n=$PR" >> "$GITHUB_OUTPUT"
          echo "ref=$head" >> "$GITHUB_OUTPUT"
      - uses: actions/checkout@v4
        with:
          ref: ${{ steps.pr.outputs.ref }}
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with: { node-version: 22 }
      # Job-local and pinned, never a global install: on the runner pool that would replace your own
      # copilot.
      - name: Install the Copilot CLI
        run: |
          npm install --no-save --no-audit --no-fund --prefix "$RUNNER_TEMP/copilot-cli" "@github/copilot@$FACTORY_COPILOT_VERSION"
          echo "$RUNNER_TEMP/copilot-cli/node_modules/.bin" >> "$GITHUB_PATH"
          echo "COPILOT_HOME=$RUNNER_TEMP/copilot-home" >> "$GITHUB_ENV"
      # Each agent may run only what its Claude twin may: tool_rules.py, a preToolUse hook, denies the
      # rest. It comes from the default branch, by its full ref so that a tag an agent pushed can't stand
      # in, never from the checkout an agent can write. It loads from $COPILOT_HOME/hooks with the folder
      # untrusted: trusting it would load the branch's hooks too.
      - name: Tool rules (the default branch's)
        env: { DEFAULT_BRANCH: "${{ github.event.repository.default_branch }}" }
        run: |
          git fetch --quiet --no-tags origin "+refs/heads/$DEFAULT_BRANCH:refs/remotes/origin/$DEFAULT_BRANCH"
          mkdir -p "$COPILOT_HOME/hooks"
          git show "refs/remotes/origin/$DEFAULT_BRANCH:.github/factory/tool_rules.py" > "$COPILOT_HOME/hooks/tool_rules.py"
          printf '%s\n' '{"version": 1, "hooks": {"preToolUse": [{"type": "command", "timeoutSec": 30, "bash": "python3 \"$COPILOT_HOOK_DIR/tool_rules.py\" review"}]}}' > "$COPILOT_HOME/hooks/tool-rules.json"
          echo '{"toolName": "bash", "toolArgs": {"command": "env"}}' | python3 "$COPILOT_HOME/hooks/tool_rules.py" review | grep -q '"deny"'
      # shell(gh pr) allows every gh pr command; the tool rules above narrow it to view, diff, checks,
      # review and comment, and deny every write. --allow-all-paths: Copilot's path check can
      # misread a review body as a path outside the checkout and, with no one to approve, deny the post;
      # this agent has no write tool, and on the pool the repo being private is the boundary.
      - name: Review agent
        env:
          GITHUB_TOKEN: ${{ github.token }}
          N: ${{ steps.pr.outputs.n }}
        run: >-
          copilot -p "/review-against-design $N" --model [[ copilot_model ]] --no-ask-user --disable-builtin-mcps
          --allow-tool 'shell(gh pr)' --allow-all-paths
