name: CI

# Tests and lint on every pull request and every push to main.
# All tests run offline on synthetic fixtures (no network, model or real traces).
# Two repository variables steer it (no workflow edit needed):
#   FACTORY_RUNNER=local  jobs run on the maintainer's Mac, in its runner pool (factory-ci skill):
#                         runs-on [self-hosted, factory-run-<run_id>]; PRs from forks never do.
#   FACTORY_CI=off        every job is skipped; a job skipped by `if:` reports Success.
# Draft PRs skip CI; marking one ready for review runs it. One job per Python version, not a
# matrix: a matrix job skipped by `if:` never posts the "Tests (Python X)" names required on main.
on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

env:
  # Ruff's default rule set changes between releases; pin it so CI and local runs agree.
  RUFF_VERSION: "[[ ruff_version ]]"

jobs:
[%- for v in python_versions %]
  test-py[[ v | replace('.', '-') ]]:
    name: Tests (Python [[ v ]])
    if: vars.FACTORY_CI != 'off' && !github.event.pull_request.draft
    runs-on: ${{ vars.FACTORY_RUNNER == 'local' && (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && fromJSON(format('["self-hosted","factory-run-{0}"]', github.run_id)) || 'ubuntu-latest' }}
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - name: Install (locked)
        run: uv sync --locked --extra dev --python [[ v ]]
      - name: Run tests
        run: uv run --no-sync pytest -q
[% endfor %]
  lint:
    name: Lint
    if: vars.FACTORY_CI != 'off' && !github.event.pull_request.draft
    runs-on: ${{ vars.FACTORY_RUNNER == 'local' && (!github.event.pull_request || github.event.pull_request.head.repo.full_name == github.repository) && fromJSON(format('["self-hosted","factory-run-{0}"]', github.run_id)) || 'ubuntu-latest' }}
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - name: ruff check
        run: uvx ruff@${{ env.RUFF_VERSION }} check .
      - name: ruff format
        run: uvx ruff@${{ env.RUFF_VERSION }} format --check .
