"""The Actions mode's tool rules for the GitHub Copilot CLI: a `preToolUse` hook.

Each agent job (`.github/workflows/factory-*.yml`) copies this file from the default branch, never from
the checkout the agent can write, into `$COPILOT_HOME/hooks/` and runs it as

    python3 tool_rules.py <stage> < payload.json

for every tool call. It denies what the stage's Claude twin may not do, so each Copilot agent may run
at most what Claude's may:

- a shell command must split into simple commands that each start with one of the stage's prefixes
  (Claude's `Bash(...)` rules); anything the small bash reader below doesn't model is denied;
- `powershell`, `write_bash` and `write_powershell` are denied;
- file writes: the design agent only under `.factory/designs/`, the review agent none;
- a little more than Claude's rules (#97): no `gh pr merge` or `gh pr review` in build, no review that
  approves or requests changes, and no `gh pr` flag before the subcommand.

It prints {"permissionDecision": "deny", ...} to deny, or nothing, so the workflow's `--allow-tool`
rules and Copilot's own checks decide. A bad stage or payload raises, and Copilot denies a hook that
fails. Stdlib only, Python 3.9+.
"""

from __future__ import annotations

import json
import os
import re
import sys

Prefix = tuple[str, ...]
Prefixes = tuple[Prefix, ...]
Words = list[str]
PREFIXES: dict[str, Prefixes] = {
    "design": (("git",), ("gh", "issue"), ("gh", "pr", "create"), ("gh", "label")),
    "build": (
        ("git",),
        ("uv", "run", "--no-sync", "pytest"),
        ("uvx", "ruff@[[ ruff_version ]]"),
        ("gh", "pr"),
        ("gh", "issue"),
        ("gh", "label"),
    ),
    "review": (
        ("gh", "pr", "view"),
        ("gh", "pr", "diff"),
        ("gh", "pr", "checks"),
        ("gh", "pr", "review"),
        ("gh", "pr", "comment"),
    ),
}
# Denied even where a prefix above allows them (#97): no agent merges or reviews a PR, but the review
# agent comments with `gh pr review N --comment`, so its review must not approve or request changes.
DENIED: dict[str, Prefixes] = {
    "design": (),
    "build": (("gh", "pr", "merge"), ("gh", "pr", "review")),
    "review": (),
}
# gh pr review's flags that take a value, so the next word (or the rest of a short-flag cluster) is it
REVIEW_VALUE_FLAGS = {"-b", "--body", "-F", "--body-file", "-R", "--repo"}
REVIEW_VERDICTS = {"--approve", "--request-changes"}
# The Copilot CLI whose tool names this was checked against; FACTORY_COPILOT_VERSION must match.
CHECKED_CLI = "1.0.116"
SHELL = "bash"
NEVER = {"powershell", "write_bash", "write_powershell"}
WRITES = {"create", "edit", "str_replace", "str_replace_editor", "apply_patch"}
DESIGNS = ".factory/designs"
# Control characters other than tab and newline: bash reads some of them differently (it drops NUL).
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
# Longer commands are denied before they're read: a hook that times out lets the call run.
MAX_COMMAND = 65536
PATCH_PATH = re.compile(
    r"^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+)$", re.MULTILINE
)
# a heredoc with a quoted delimiter (so its body is literal), ending its line
HEREDOC = re.compile(r"<<[ \t]*(['\"])([A-Za-z0-9_]+)\1[ \t]*\n")


class Refused(Exception):
    """A shell command this reader doesn't model, so it isn't allowed."""


def split_commands(command: str) -> list[Words]:
    """The simple commands in a bash command line, each as its words after quote removal.

    Splits on `&&`, `||`, `|`, `;` and newlines. Raises Refused on any expansion, substitution,
    redirection, subshell, group, background job, glob or comment, so what it returns is what bash
    runs. The one redirection it reads is a quoted heredoc (`<<'EOF'`) that ends its line.
    """
    commands: list[Words] = []
    words: list[str] = []
    word: list[str] | None = None  # the current word's characters; None between words
    i, n = 0, len(command)

    def end_word() -> None:
        nonlocal word
        if word is not None:
            words.append("".join(word))
        word = None

    def end_command() -> None:
        nonlocal words
        end_word()
        if words:
            commands.append(words)
        words = []

    while i < n:
        c = command[i]
        if c == "'":
            j = command.find("'", i + 1)
            if j < 0:
                raise Refused("an unclosed quote")
            word = word if word is not None else []
            word.append(command[i + 1 : j])
            i = j + 1
        elif c == '"':
            chars = []
            i += 1
            while True:
                if i >= n:
                    raise Refused("an unclosed quote")
                c = command[i]
                if c == '"':
                    break
                if c in "$`":
                    raise Refused("$ or a backtick outside single quotes")
                if c == "\\" and i + 1 < n and command[i + 1] in '"\\$`\n':
                    if command[i + 1] != "\n":
                        chars.append(command[i + 1])
                    i += 2
                    continue
                chars.append(c)
                i += 1
            word = word if word is not None else []
            word.extend(chars)
            i += 1
        elif c == "\\":
            if i + 1 >= n:
                raise Refused("a trailing backslash")
            if command[i + 1] != "\n":
                word = word if word is not None else []
                word.append(command[i + 1])
            # bash drops a backslash-newline before it reads words: it neither starts nor ends one, so a
            # "#" right after it still starts a comment (found in a code review)
            i += 2
        elif c in " \t":
            end_word()
            i += 1
        elif c in ";\n":
            end_command()
            i += 1
        elif command.startswith("&&", i) or command.startswith("||", i):
            end_command()
            i += 2
        elif c == "|" and not command.startswith("|&", i):
            end_command()
            i += 1
        elif command.startswith("<<", i):
            end_word()
            m = HEREDOC.match(command, i)
            if not m or not words:
                raise Refused("a heredoc that isn't <<'WORD' at the end of its line")
            i = m.end()
            while True:  # the body: every line up to the delimiter's own line
                nl = command.find("\n", i)
                line = command[i:] if nl < 0 else command[i:nl]
                i = n if nl < 0 else nl + 1
                if line == m.group(2):
                    break
                if nl < 0:
                    raise Refused("a heredoc without its closing line")
            end_command()
        elif c in "$`":
            raise Refused("$ or a backtick outside single quotes")
        elif c in "<>()&|{}":
            raise Refused(f"{c!r} (a redirection, subshell, group or background job)")
        elif c in "*?[":
            raise Refused("an unquoted glob character (*, ? or [)")
        elif c == "#" and word is None:
            raise Refused("a comment")
        else:
            word = word if word is not None else []
            word.append(c)
            i += 1
    end_command()
    return commands


def deny(stage: str, why: str) -> dict:
    allowed = "; ".join(" ".join(p) + " ..." for p in PREFIXES[stage])
    return {
        "permissionDecision": "deny",
        "permissionDecisionReason": (
            f"the factory's {stage} agent may not do this: {why}. It may run only these commands, "
            f"alone or joined with && or ;: {allowed}. No $, backticks, redirections, globs, "
            "subshells or cd (use git -C): put text in single quotes, or pass it on stdin with "
            "--body-file - and a heredoc whose delimiter is quoted, <<'EOF', ending its line. Read "
            "files with the view, glob and grep tools."
        ),
    }


def approves(words: Words) -> bool:
    """Whether a `gh pr review ...` command approves or requests changes, read as gh's flag parser does."""
    i = 3
    while i < len(words):
        w = words[i]
        i += 1
        if w == "--":
            break
        if w.startswith("--"):
            name = w.split("=", 1)[0]
            if name in REVIEW_VERDICTS:
                return True
            if name in REVIEW_VALUE_FLAGS and "=" not in w:
                i += 1
        elif re.fullmatch(r"-[A-Za-z]+(=.*)?", w):  # a short-flag cluster, such as -cb or -a=false
            letters, _, value = w[1:].partition("=")
            for k, c in enumerate(letters):
                if c in "ar":
                    return True
                if c in "bFR":  # takes a value: the rest of the word, or else the next word
                    if k == len(letters) - 1 and not value and "=" not in w:
                        i += 1
                    break
    return False


def gh_pr_refused(stage: str, words: Words) -> str | None:
    """Why a `gh pr` command is denied even though a prefix allows it, or None."""
    if words[:2] != ["gh", "pr"]:
        return None
    if len(words) > 2 and words[2].startswith("-"):
        return "gh pr flags go after the subcommand (gh pr <subcommand> ...)"
    if any(tuple(words[: len(p)]) == p for p in DENIED[stage]):
        return f"`{' '.join(words[:3])}` isn't for the {stage} agent"
    if words[2:3] == ["review"] and approves(words):
        return "a review may only comment (--comment), never approve or request changes"
    return None


def check_shell(stage: str, command: object) -> str | None:
    """Why a shell command is denied, or None if every simple command in it is allowed."""
    if not isinstance(command, str):
        raise TypeError("a shell call without a command")
    if len(command) > MAX_COMMAND:
        return f"a command over {MAX_COMMAND} characters"
    if CONTROL.search(command):
        return "a control character (bash drops a NUL, for one)"
    try:
        commands = split_commands(command)
    except Refused as e:
        return f"the command has {e}"
    if not commands:
        return "an empty command"
    for words in commands:
        if not any(tuple(words[: len(p)]) == p for p in PREFIXES[stage]):
            return f"`{' '.join(words)[:80]}` isn't one of this stage's commands"
        why = gh_pr_refused(stage, words)
        if why:
            return why
    return None


def written_paths(tool: str, args: object) -> list[str]:
    """The files a write names (apply_patch: every file its patch adds, changes, deletes or moves)."""
    if tool == "apply_patch":
        text = args.get("input") if isinstance(args, dict) else args
        return PATCH_PATH.findall(text) if isinstance(text, str) else []
    path = args.get("path") if isinstance(args, dict) else None
    return [path] if isinstance(path, str) else []


def check_write(stage: str, tool: str, args: object, cwd: str) -> str | None:
    """Why a file write is denied, or None."""
    if stage == "build":
        return None
    if stage != "design":
        return "this agent writes no files"
    designs = os.path.realpath(os.path.join(os.environ.get("GITHUB_WORKSPACE") or cwd, DESIGNS))
    paths = written_paths(tool, args)
    if not paths:
        return "a write whose files can't be read"
    for path in paths:
        for name in {path, path.strip()}:  # a patch's path may carry spaces the tool trims
            target = os.path.realpath(os.path.join(cwd, name))
            if target == designs or os.path.commonpath([designs, target]) != designs:
                return f"{path[:120]} is outside {DESIGNS}/"
    return None


def decide(stage: str, payload: object) -> dict | None:
    """The hook's answer to one preToolUse payload: a deny, or None for no decision."""
    if stage not in PREFIXES:
        raise ValueError(f"unknown stage {stage!r}")
    if not isinstance(payload, dict) or not isinstance(payload.get("toolName"), str):
        raise TypeError("not a preToolUse payload")
    tool = payload["toolName"]
    args = payload.get("toolArgs")
    if isinstance(args, str) and tool != "apply_patch":
        args = json.loads(args)
    cwd = payload.get("cwd") if isinstance(payload.get("cwd"), str) else os.getcwd()
    if tool == SHELL:
        if not isinstance(args, dict):
            raise TypeError("a shell call without arguments")
        why = check_shell(stage, args.get("command"))
    elif tool in NEVER:
        why = f"the {tool} tool isn't allowed"
    elif tool in WRITES:
        why = check_write(stage, tool, args, cwd)
    else:
        why = None
    return deny(stage, why) if why else None


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: tool_rules.py design|build|review < payload.json")
    answer = decide(sys.argv[1], json.load(sys.stdin))
    if answer:
        print(json.dumps(answer))


if __name__ == "__main__":
    main()
